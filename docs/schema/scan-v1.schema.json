{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HarnageaGabriel/scadenza/docs/schema/scan-v1.schema.json",
  "title": "scadenza scan output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "domains", "sources_used", "certificates", "findings", "unresolved", "probe_errors", "diagnostics", "owners", "coverage"],
  "properties": {
    "schema_version": {"const": "scadenza.scan/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "domains": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sources_used": {"type": "array", "items": {"enum": ["certspotter", "crtsh", "tls", "kube", "azure-keyvault"]}},
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint_sha256", "serial", "names", "issuer", "not_before", "not_after", "lifetime_days", "verdict_100d", "correlation_method", "policy", "public", "observations", "owners", "renewal"],
        "properties": {
          "fingerprint_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
          "serial": {"type": "string"},
          "names": {"type": "array", "items": {"type": "string"}},
          "issuer": {"type": "string"},
          "not_before": {"type": "string", "format": "date-time"},
          "not_after": {"type": "string", "format": "date-time"},
          "lifetime_days": {"type": "integer", "minimum": 0},
          "verdict_100d": {"enum": ["ok", "exceeds", "unknown", "not_applicable"]},
          "correlation_method": {"enum": ["sha256", "issuer_serial", "names_and_expiry", "unresolved"]},
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_validity_at_issuance_days", "compliant_at_issuance", "next_limit_days", "next_limit_effective", "fits_next_limit"],
            "properties": {
              "max_validity_at_issuance_days": {"type": "integer", "minimum": 0},
              "compliant_at_issuance": {"type": "boolean"},
              "next_limit_days": {"type": "integer", "minimum": 0},
              "next_limit_effective": {"type": "string"},
              "fits_next_limit": {"type": "boolean"}
            }
          },
          "public": {"type": ["boolean", "null"]},
          "owners": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["owner", "owner_source", "location"],
              "properties": {
                "owner": {"type": "string", "minLength": 1},
                "owner_source": {"enum": ["label", "annotation", "namespace-label", "namespace-annotation", "mapping-file", "tag"]},
                "location": {"type": "string", "minLength": 1}
              }
            }
          },
          "renewal": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "health", "evidence", "risks"],
            "properties": {
              "mode": {"enum": ["automatic", "manual", "unknown"]},
              "health": {"enum": ["healthy", "degraded", "configured", "unknown"]},
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source", "fact", "value"],
                  "properties": {
                    "source": {"enum": ["cert-manager", "ct", "tls", "kube-secret", "config", "keyvault"]},
                    "fact": {"type": "string", "minLength": 1},
                    "value": {"type": "string"},
                    "vault": {"type": "string", "minLength": 1}
                  }
                }
              },
              "risks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "detail"],
                  "properties": {
                    "kind": {"enum": ["renew-before-exceeds-lifetime", "renew-before-loop-at-next-limit", "duration-exceeds-next-limit", "renewal-degraded", "manual-renewal-after-limit", "renewal-config-invalid", "keyvault-validity-exceeds-next-limit", "keyvault-renew-trigger-exceeds-lifetime"]},
                    "detail": {"type": "string", "minLength": 1},
                    "effective": {"type": "string"}
                  }
                }
              }
            }
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "location", "detail"],
              "properties": {
                "source": {"enum": ["ct-certspotter", "ct-crtsh", "tls", "kube-secret", "kube-secret-metadata", "cert-manager", "azure-keyvault"]},
                "location": {"type": "string"},
                "detail": {"type": "string"},
                "kubernetes": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["resource", "namespace", "name"],
                  "properties": {
                    "resource": {"type": "string", "minLength": 1},
                    "namespace": {"type": "string"},
                    "name": {"type": "string", "minLength": 1},
                    "secret_name": {"type": "string"},
                    "issuer_kind": {"type": "string"},
                    "issuer_name": {"type": "string"},
                    "issuer_type": {"enum": ["acme", "ca", "selfSigned", "vault", "venafi", "external", "unknown"]},
                    "acme_server": {"type": "string"},
                    "duration": {"type": "string"},
                    "renew_before": {"type": "string"},
                    "renew_before_percentage": {"type": "string"},
                    "status_not_before": {"type": "string"},
                    "status_not_after": {"type": "string"},
                    "status_renewal_time": {"type": "string"},
                    "ready": {"type": "string"},
                    "ready_reason": {"type": "string"},
                    "certificate_name": {"type": "string"}
                  }
                },
                "azure_keyvault": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "vault", "version", "not_before", "not_after", "issuer", "lifetime_actions", "tags"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "vault": {"type": "string", "minLength": 1},
                    "version": {"type": "string"},
                    "enabled": {"type": "boolean"},
                    "not_before": {"type": "string", "format": "date-time"},
                    "not_after": {"type": "string", "format": "date-time"},
                    "issuer": {"type": "string", "minLength": 1},
                    "policy_validity_months": {"type": "integer", "minimum": 1},
                    "lifetime_actions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "description": "Azure lifetime action type; empty and future provider values are preserved."}, "days_before_expiry": {"type": "integer", "minimum": 0}, "lifetime_percentage": {"type": "integer", "minimum": 0}}}},
                    "tags": {"type": "object", "additionalProperties": {"type": "string"}},
                    "content_type": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "fingerprint", "names", "detail"],
        "properties": {
          "kind": {"enum": ["matched", "ct_only", "live_only", "kube_only", "not_checked", "unknown", "exceeds-100d", "not-compliant-at-issuance", "renew-before-exceeds-lifetime", "renew-before-loop-at-next-limit", "duration-exceeds-next-limit", "renewal-degraded", "manual-renewal-after-limit", "renewal-config-invalid", "keyvault-validity-exceeds-next-limit", "keyvault-renew-trigger-exceeds-lifetime"]},
          "fingerprint": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
          "names": {"type": "array", "items": {"type": "string"}},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason", "detail"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "reason": {"enum": ["wildcard", "host-cap", "invalid-name"]},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "probe_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "port", "class", "detail"],
        "properties": {
          "host": {"type": "string", "minLength": 1},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "class": {"enum": ["dns", "connect-timeout", "refused", "canceled", "tls-alert", "no-certificate", "handshake-failed", "blocked-address"]},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "owner_source", "certificates", "automatic", "manual", "unknown", "degraded", "manual_renewals_per_year"],
        "properties": {
          "owner": {"type": "string", "minLength": 1},
          "owner_source": {"enum": ["", "label", "annotation", "namespace-label", "namespace-annotation", "mapping-file", "tag"]},
          "certificates": {"type": "integer", "minimum": 0},
          "automatic": {"type": "integer", "minimum": 0},
          "manual": {"type": "integer", "minimum": 0},
          "unknown": {"type": "integer", "minimum": 0},
          "degraded": {"type": "integer", "minimum": 0},
          "manual_renewals_per_year": {
            "type": "object",
            "additionalProperties": false,
            "required": ["200d", "100d", "47d"],
            "properties": {
              "200d": {"type": "integer", "minimum": 0},
              "100d": {"type": "integer", "minimum": 0},
              "47d": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets_requested", "targets_probed", "targets_failed", "names_not_checked", "sources", "ratio"],
      "properties": {
        "targets_requested": {"type": "integer", "minimum": 0},
        "targets_probed": {"type": "integer", "minimum": 0},
        "targets_failed": {"type": "integer", "minimum": 0},
        "names_not_checked": {"type": "integer", "minimum": 0},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "detail"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "status": {"enum": ["ok", "partial", "failed", "not_requested"]},
              "detail": {"type": "string", "minLength": 1}
            }
          }
        },
        "ratio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "slug", "severity", "summary", "explanation", "remediation"],
        "properties": {
          "code": {"type": "string", "pattern": "^SCD-[0-9]{4}$"},
          "slug": {"type": "string", "minLength": 1},
          "severity": {"enum": ["error", "warning", "info"]},
          "summary": {"type": "string", "minLength": 1},
          "explanation": {"type": "string", "minLength": 1},
          "remediation": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
